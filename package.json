{
  "name": "edge-runbook-copilot",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "types": "wrangler types --strict-vars false",
    "typecheck": "pnpm run types && tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm run typecheck && vite build",
    "cf:dev": "pnpm run build && wrangler dev",
    "cf:dev:offline": "pnpm run build && wrangler dev --local --var LLM_MODE:offline",
    "e2e": "node scripts/e2e.mjs",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.0",
    "@ai-sdk/react": "^4.0.0",
    "@cloudflare/ai-chat": "^0.12.2",
    "agents": "^0.33.0",
    "ai": "^7.0.163",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0"
  }
}
